// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ========================
// ENUMS
// ========================

enum UserRole {
  TRAVELER
  RIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleType {
  CAR
  BIKE
  VAN
  BUS
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum RideStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  JAZZCASH
  EASYPAISA
  CASH
  WALLET
}

enum NotificationType {
  BOOKING_RECEIVED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  RIDE_STARTED
  RIDE_COMPLETED
  NEW_MESSAGE
  NEW_REVIEW
  PAYMENT_RECEIVED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  RIDE_REMINDER
  DRIVER_ARRIVED
  SOS_ALERT
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ========================
// MODELS
// ========================

// --- User ---
model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  emailVerified     DateTime?
  password          String?
  name              String?
  image             String?
  phone             String?
  role              UserRole  @default(TRAVELER)
  isActive          Boolean   @default(true)
  isBanned          Boolean   @default(false)
  referralCode      String?   @unique
  referredBy        String?   @db.ObjectId
  loyaltyPoints     Int       @default(0)
  walletBalance     Float     @default(0)
  preferredLanguage String    @default("en")
  preferredCurrency String    @default("USD")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  profile           Profile?
  vehicles          Vehicle[]
  ridesAsRider      Ride[]            @relation("RiderRides")
  bookingsAsTraveler Booking[]        @relation("TravelerBookings")
  reviews           Review[]          @relation("ReviewAuthor")
  receivedReviews   Review[]          @relation("ReviewTarget")
  notifications     Notification[]
  favorites         Favorite[]
  sentMessages      Message[]         @relation("MessageSender")
  conversations     ConversationParticipant[]
  payments          Payment[]
  supportTickets    SupportTicket[]
  verification      Verification?
  searchHistory     SearchHistory[]
  rideLocations     RideLocation[]
  callHistory       CallHistory[]
  accounts          Account[]
  sessions          Session[]

  @@map("users")
}

// --- Profile (Extended User Info) ---
model Profile {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  city            String?
  country         String?
  emergencyName   String?
  emergencyPhone  String?
  emergencyEmail  String?
  travelPrefs     String[]  @default([])
  languages       String[]  @default([])
  totalTrips      Int       @default(0)
  totalDistance   Float     @default(0)
  averageRating   Float     @default(0)
  totalReviews    Int       @default(0)
  isRiderVerified Boolean   @default(false)
  isIdVerified    Boolean   @default(false)
  idType          String?
  idNumber        String?
  licenseNumber   String?
  joinedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("profiles")
}

// --- NextAuth Account ---
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// --- NextAuth Session ---
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

// --- NextAuth Verification Token ---
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Vehicle ---
model Vehicle {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  ownerId            String           @db.ObjectId
  owner              User             @relation(fields: [ownerId], references: [id])
  name               String
  brand              String
  model              String
  year               Int
  registrationNumber String
  vehicleType        VehicleType
  fuelType           FuelType
  transmission       TransmissionType @default(MANUAL)
  seatCapacity       Int
  color              String?
  insuranceNumber    String?
  photos             String[]         @default([])
  amenities          String[]         @default([])
  isActive           Boolean          @default(true)
  isVerified         Boolean          @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rides              Ride[]

  @@map("vehicles")
}

// --- Ride ---
model Ride {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  riderId           String     @db.ObjectId
  rider             User       @relation("RiderRides", fields: [riderId], references: [id])
  vehicleId         String     @db.ObjectId
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id])
  
  // Location
  pickupAddress     String
  pickupLat         Float
  pickupLng         Float
  destinationAddress String
  destinationLat    Float
  destinationLng    Float
  stops             Json[]     @default([])
  
  // Schedule
  departureDate     DateTime
  departureTime     String
  estimatedArrival  String?
  distanceKm        Float?
  durationMinutes   Int?
  
  // Pricing & Seats
  pricePerSeat      Float
  availableSeats    Int
  maxPassengers     Int        @default(4)
  
  // Settings
  instantBooking    Boolean    @default(false)
  isRecurring       Boolean    @default(false)
  recurringDays     String[]   @default([])
  luggageAllowed    Boolean    @default(true)
  smokingAllowed    Boolean    @default(false)
  petsAllowed       Boolean    @default(false)
  womenOnly         Boolean    @default(false)
  
  // Content
  description       String?
  rules             String?
  slug              String?    @unique
  
  status            RideStatus @default(PUBLISHED)
  isFeatured        Boolean    @default(false)
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  bookings          Booking[]
  reviews           Review[]
  locations         RideLocation[]
  rideHistory       RideHistory?

  @@map("rides")
}

// --- Booking ---
model Booking {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingRef      String        @unique @default(cuid())
  travelerId      String        @db.ObjectId
  traveler        User          @relation("TravelerBookings", fields: [travelerId], references: [id])
  rideId          String        @db.ObjectId
  ride            Ride          @relation(fields: [rideId], references: [id])
  
  seatsBooked     Int           @default(1)
  totalAmount     Float
  status          BookingStatus @default(PENDING)
  
  // Passenger Details
  passengerName   String?
  passengerPhone  String?
  passengerNotes  String?
  
  // Pickup/Dropoff customization
  pickupAddress   String?
  dropoffAddress  String?
  
  // QR Code
  qrCode          String?
  
  // Promo
  couponCode      String?
  discountAmount  Float         @default(0)
  
  // Timestamps
  confirmedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment         Payment?
  review          Review?
  conversation    Conversation?
  callHistory     CallHistory[]

  @@map("bookings")
}

// --- Payment ---
model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId         String        @unique @db.ObjectId
  booking           Booking       @relation(fields: [bookingId], references: [id])
  userId            String        @db.ObjectId
  user              User          @relation(fields: [userId], references: [id])
  
  amount            Float
  currency          String        @default("USD")
  method            PaymentMethod @default(CASH)
  status            PaymentStatus @default(PENDING)
  
  // Stripe
  stripePaymentIntentId String?
  stripeChargeId        String?
  
  // Refund
  refundedAmount    Float?
  refundedAt        DateTime?
  refundReason      String?
  
  // Invoice
  invoiceUrl        String?
  
  metadata          Json?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("payments")
}

// --- Coupon ---
model Coupon {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  code            String    @unique
  description     String?
  discountType    String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue   Float
  minOrderAmount  Float     @default(0)
  maxDiscount     Float?
  usageLimit      Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@map("coupons")
}

// --- Conversation ---
model Conversation {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String?   @unique @db.ObjectId
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  
  participants ConversationParticipant[]
  messages     Message[]
  
  lastMessage   String?
  lastMessageAt DateTime?
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("conversations")
}

// --- Conversation Participant ---
model ConversationParticipant {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

// --- Message ---
model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.ObjectId
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  
  content        String?
  messageType    String       @default("TEXT") // TEXT | IMAGE | FILE | VOICE | EMOJI
  mediaUrl       String?
  fileName       String?
  
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  readBy         String[]     @default([])
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("messages")
}

// --- Review ---
model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId    String   @db.ObjectId
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId    String   @db.ObjectId
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rideId      String   @db.ObjectId
  ride        Ride     @relation(fields: [rideId], references: [id])
  bookingId   String?  @unique @db.ObjectId
  booking     Booking? @relation(fields: [bookingId], references: [id])
  
  rating      Int      // 1-5
  comment     String?
  images      String[] @default([])
  
  // Helpfulness
  helpfulVotes Int     @default(0)
  
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reviews")
}

// --- Notification ---
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  imageUrl  String?
  actionUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

// --- Favorite ---
model Favorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  riderId    String?  @db.ObjectId
  locationName String?
  locationLat  Float?
  locationLng  Float?
  createdAt  DateTime @default(now())

  @@map("favorites")
}

// --- Support Ticket ---
model SupportTicket {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  userId      String               @db.ObjectId
  user        User                 @relation(fields: [userId], references: [id])
  subject     String
  description String
  category    String               @default("GENERAL")
  status      SupportTicketStatus  @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  attachments String[]             @default([])
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("support_tickets")
}

// --- Verification ---
model Verification {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  userId        String             @unique @db.ObjectId
  user          User               @relation(fields: [userId], references: [id])
  idType        String?
  idFrontUrl    String?
  idBackUrl     String?
  selfieUrl     String?
  licenseUrl    String?
  status        VerificationStatus @default(PENDING)
  reviewNotes   String?
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  updatedAt     DateTime           @updatedAt

  @@map("verifications")
}

// --- Ride Location (GPS snapshots) ---
model RideLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId    String   @db.ObjectId
  ride      Ride     @relation(fields: [rideId], references: [id])
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime @default(now())

  @@map("ride_locations")
}

// --- Ride History ---
model RideHistory {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId           String   @unique @db.ObjectId
  ride             Ride     @relation(fields: [rideId], references: [id])
  totalPassengers  Int      @default(0)
  totalRevenue     Float    @default(0)
  totalDistance    Float    @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  routePolyline    String?
  createdAt        DateTime @default(now())

  @@map("ride_histories")
}

// --- Search History ---
model SearchHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  pickup      String?
  destination String?
  date        DateTime?
  createdAt   DateTime @default(now())

  @@map("search_histories")
}

// --- Call History ---
model CallHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String?  @db.ObjectId
  booking     Booking? @relation(fields: [bookingId], references: [id])
  callerId    String   @db.ObjectId
  caller      User     @relation(fields: [callerId], references: [id])
  callType    String   @default("AUDIO") // AUDIO | VIDEO
  duration    Int?     // seconds
  status      String   @default("COMPLETED") // MISSED | COMPLETED | REJECTED
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  @@map("call_histories")
}
